PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Persistensi ruang (A5): opsional. Kosongkan untuk mode in-memory (dev tanpa Atlas),
# atau isi mongodb+srv://user:pass@cluster.../myvtt agar sesi bertahan setelah restart.
MONGODB_URI=

# Unggah aset (B1 & C7): buat gratis di cloudinary.com lalu isi nilai "API Keys" kamu.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
